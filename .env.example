# Optional. Copy to .env for local use.
# NUXT_BASE_URL=https://hub.example.com
# NUXT_SESSION_SECRET=
# NUXT_GITHUB_CLIENT_ID=
# NUXT_GITHUB_CLIENT_SECRET=
# HUB_DB=.data/hub.sqlite

# Development only (`npm run dev:login` sets these). A production build refuses to start if they are set.
# NUXT_DEV_LOGIN_EMAIL=dev@example.test
# NUXT_DEV_TOKEN=devtoken
